{
  "annotations": { "list": [] },
  "description": "应用指标看板（RED 三要素 + USE 基础资源）。数据来源：demo-api 的 /metrics 端点（prometheus-fastapi-instrumentator 自动埋点）。对应 Day 8 应用指标埋点实践。",
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "RED · 应用服务三要素",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "id": 200
    },
    {
      "type": "timeseries",
      "title": "Rate — 每秒请求数（按路径）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum by (path) (rate(http_requests_total{job=\"demo-api\"}[$__rate_interval]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Errors — 错误率（按状态码）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum by (path, status_code) (rate(http_requests_total{job=\"demo-api\", status_code=~\"5..|4..\"}[$__rate_interval])) / sum by (path) (rate(http_requests_total{job=\"demo-api\"}[$__rate_interval])) * 100",
          "legendFormat": "{{path}} {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Duration — 响应时间 P95（按路径）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{job=\"demo-api\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{path}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Duration — 响应时间 P50（按路径）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, path) (rate(http_request_duration_seconds_bucket{job=\"demo-api\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{path}} p50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "应用内部状态",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "id": 201
    },
    {
      "type": "timeseries",
      "title": "Active Requests — 并发活跃请求数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "http_requests_active{job=\"demo-api\"}",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "今日累计请求",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{job=\"demo-api\"}[1d]))",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "5xx 错误数",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{job=\"demo-api\", status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 38,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "应用指标 · RED 三要素",
  "uid": "app-metrics-red",
  "version": 1
}
